filters:
  or:
    - source == "relax1000DS"
    - source == "relax1000CO"
    - source == "relax1000OS"
    - source == "relax1000CN"
formulas:
  qorder: if(qtype == "选择", 1, if(qtype == "填空", 2, if(qtype == "解答", 3, 4)))
properties:
  file.name:
    displayName: 题目
  source:
    displayName: 题库
  subject:
    displayName: 科目
  chapter:
    displayName: 章
  section:
    displayName: 小节
  level:
    displayName: 篇
  plate:
    displayName: 板块
  topic:
    displayName: 考点
  qtype:
    displayName: 题型
  answer:
    displayName: 答案
  score:
    displayName: 分值
  year:
    displayName: 年份
  answer_status:
    displayName: 答案状态
views:
  - type: table
    name: relax1000 数据结构
    filters: source == "relax1000DS"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - qtype
      - answer
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.qorder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: relax1000 计算机组成原理
    filters: source == "relax1000CO"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - qtype
      - answer
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.qorder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: relax1000 操作系统
    filters: source == "relax1000OS"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - qtype
      - answer
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.qorder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: relax1000 计算机网络
    filters: source == "relax1000CN"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - qtype
      - answer
    sort:
      - property: file.folder
        direction: ASC
      - property: formula.qorder
        direction: ASC
      - property: file.name
        direction: ASC
